languagesystem DFLT dflt;

languagesystem latn dflt;
languagesystem latn AZE;
languagesystem latn CRT;
languagesystem latn KAZ;
languagesystem latn TAT;
languagesystem latn TRK;
languagesystem latn ROM;
languagesystem latn MOL;
languagesystem latn CAT;

# GPOS 
lookup kernHorizontalKerninginLatinloo {
  lookupflag 0;
    pos \T \A -512;
    pos \b \x -96;
    pos \b \w -64;
    pos \e \x -96;
    pos \e \w -64;
    pos \o \x -96;
    pos \o \w -64;
    pos \p \x -96;
    pos \p \w -64;
  subtable;
    pos \C \q -64;
    pos \C \o -64;
    pos \C \g -64;
    pos \C \e -64;
    pos \C \d -64;
    pos \C \c -64;
    pos \C \a -64;
    pos \W \q -256;
    pos \W \o -256;
    pos \W \g -256;
    pos \W \e -256;
    pos \W \d -256;
    pos \W \c -256;
    pos \W \a -256;
    pos \X \q -128;
    pos \X \o -128;
    pos \X \g -128;
    pos \X \e -128;
    pos \X \d -128;
    pos \X \c -128;
    pos \X \a -128;
    pos \k \q -96;
    pos \k \o -96;
    pos \k \g -96;
    pos \k \e -96;
    pos \k \d -96;
    pos \k \c -96;
    pos \k \a -96;
    pos \m \y -64;
    pos \m \w -64;
    pos \m \v -64;
    pos \t \q -64;
    pos \t \o -64;
    pos \t \g -64;
    pos \t \e -64;
    pos \t \d -64;
    pos \t \c -64;
    pos \t \a -64;
    pos \v \q -64;
    pos \v \o -64;
    pos \v \g -64;
    pos \v \e -64;
    pos \v \d -64;
    pos \v \c -64;
    pos \v \a -64;
    pos \w \q -64;
    pos \w \o -64;
    pos \w \g -64;
    pos \w \e -64;
    pos \w \d -64;
    pos \w \c -64;
    pos \w \a -64;
    pos \x \q -96;
    pos \x \o -96;
    pos \x \g -96;
    pos \x \e -96;
    pos \x \d -96;
    pos \x \c -96;
    pos \x \a -96;
    pos \y \q -64;
    pos \y \o -64;
    pos \y \g -64;
    pos \y \e -64;
    pos \y \d -64;
    pos \y \c -64;
    pos \y \a -64;
  subtable;
    @kc2_first_0 = [   \T    ];
    @kc2_first_1 = [   \Y    ];
    @kc2_first_2 = [   \m \n    ];
    @kc2_first_3 = [   \K    ];
    @kc2_first_4 = [   \L    ];
    @kc2_first_5 = [   \P    ];
    @kc2_first_6 = [   \V    ];
    @kc2_first_7 = [   \b \e \o \p    ];
    @kc2_second_1 = [   \a \c \d \e \g \o \q    ];
    @kc2_second_2 = [   \v \w \y    ];
    pos @kc2_first_0 @kc2_second_1 -512;
    pos @kc2_first_1 @kc2_second_1 -512;
    pos @kc2_first_2 @kc2_second_2 -64;
    pos @kc2_first_3 @kc2_second_1 -128;
    pos @kc2_first_4 @kc2_second_1 -128;
    pos @kc2_first_5 @kc2_second_1 -64;
    pos @kc2_first_6 @kc2_second_1 -256;
    pos @kc2_first_7 @kc2_second_2 -64;
} kernHorizontalKerninginLatinloo;
feature aalt {
feature locl;
feature sups;
feature numr;
feature dnom;
feature frac;
feature ordn;
feature ss01;
feature ss02;
} aalt;
feature ccmp {
lookup ccmp_Other_1 {
	@CombiningTopAccents = [acutecomb brevecomb breveinvertedcomb caroncomb circumflexcomb commaturnedabovecomb dieresiscomb dotaccentcomb gravecomb hungarumlautcomb macroncomb ringcomb tildecomb];
	@CombiningNonTopAccents = [cedillacomb ogonekcomb];
	sub [i j]' @CombiningTopAccents by [idotless jdotless];
	sub [i j]' @CombiningNonTopAccents @CombiningTopAccents by [idotless jdotless];
	sub iogonek' @CombiningTopAccents by idotless ogonekcomb;
} ccmp_Other_1;

lookup ccmp_latn_1 {
	sub fi by f i;
	sub fl by f l;
	sub lj by l j;
	sub Lj by L j;
	sub LJ by L J;
	sub nj by n j;
	sub Nj by N j;
	sub NJ by N J;
	sub dzcaron by d zcaron;
	sub Dzcaron by D zcaron;
	sub DZcaron by D Zcaron;
} ccmp_latn_1;

script latn;
lookup ccmp_latn_1;
} ccmp;
feature locl {
script latn;
language AZE;
lookup locl_latn_0 {
	sub i by idotaccent;
} locl_latn_0;
language CRT;
lookup locl_latn_0;
language KAZ;
lookup locl_latn_0;
language TAT;
lookup locl_latn_0;
language TRK;
lookup locl_latn_0;

script latn;
language ROM;
lookup locl_latn_1 {
	sub Scedilla by Scommaaccent;
	sub scedilla by scommaaccent;
} locl_latn_1;
language MOL;
lookup locl_latn_1;

script latn;
language CAT;
lookup locl_latn_2 {
	sub  l' periodcentered' l by ldot;
	sub  L' periodcentered' L by Ldot;
} locl_latn_2;
} locl;
feature sups {
sub one by onesuperior;
sub two by twosuperior;
sub three by threesuperior;
sub four by foursuperior;
} sups;
feature numr {
sub one by one.numr;
sub two by two.numr;
sub three by three.numr;
sub four by four.numr;
} numr;
feature dnom {
sub one by one.dnom;
sub two by two.dnom;
sub three by three.dnom;
sub four by four.dnom;
} dnom;
feature frac {
sub one slash four by onequarter;
sub one slash two by onehalf;
sub three slash four by threequarters;
} frac;
feature ordn {
sub [zero one two three four five six seven eight nine] [A a]' by ordfeminine;
sub [zero one two three four five six seven eight nine] [O o]' by ordmasculine;
} ordn;
feature liga {
lookupflag IgnoreMarks;
sub f i by fi;
sub f l by fl;
} liga;
feature ss01 {
featureNames {
  name "ss01";
};
sub a by a.ss01;
} ss01;
feature ss02 {
featureNames {
  name "ss02";
};
sub R by R.ss02;
} ss02;
